<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_admission_ex_form" model="ir.ui.view">
        <field name="name">admission.ex.form</field>
        <field name="model">admission.admission</field>
        <field name="inherit_id" ref="school.view_admission_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nationality']" position="after">
                <field name="hobby" readonly="status == 'accept' or status == 'reject'"/>
            </xpath>
        </field>
    </record>

    <!-- List View -->
    <record id="view_admission_ex_list" model="ir.ui.view">
        <field name="name">admission.ex.list</field>
        <field name="model">admission.admission</field>
        <field name="inherit_id" ref="school.view_admission_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="after">
                <field name="hobby"/>
            </xpath>
        </field>
    </record>
</odoo>