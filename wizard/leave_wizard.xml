<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Action Window Bound to Student Form Action Menu -->
    <record id="action_open_student_leave_wizard" model="ir.actions.act_window">
        <field name="name">Process Student Leave</field>
        <field name="res_model">leave.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="school.model_student_student"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_student_id': active_id}</field>
    </record>

    <!-- 2. Wizard Form View -->
    <record id="view_student_leave_wizard_form" model="ir.ui.view">
        <field name="name">leave.wizard.form</field>
        <field name="model">leave.wizard</field>
        <field name="arch" type="xml">
            <form string="Process Student Leave Clearance">
                <sheet>
                    <group>
                        <field name="student_id" options="{'no_create': True}"/>
                        <field name="due_payment"/>
                        <field name="leave_date"/>
                        <field name="reason" placeholder="State reason for leaving..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_process_leave" string="Process Leaving" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_student_leave_list" model="ir.ui.view">
        <field name="name">student.leave.list</field>
        <field name="model">student.leave</field>
        <field name="arch" type="xml">
            <list string="Left Students History" create="false" edit="false">
                <field name="student_id"/>
                <field name="leave_date"/>
                <field name="institute_id"/>
                <field name="branch_id"/>
                <field name="level_id"/>
                <field name="grade_id"/>
            </list>
        </field>
    </record>

    <record id="action_student_leave_records" model="ir.actions.act_window">
        <field name="name">Left Students History</field>
        <field name="res_model">student.leave</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 5. Reporting Sub-menu -->
    <menuitem id="menu_student_leave_history"
              name="Left Students History"
              parent="menu_reporting"
              action="action_student_leave_records"
              sequence="30"/>

</odoo>